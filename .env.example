# --- API Keys ---
# OpenRouter
OPENROUTER_API_KEY=sua_chave_aqui

# Groq
GROQ_API_KEY=sua_chave_aqui

# OpenAI
OPENAI_API_KEY=sua_chave_aqui

# ElevenLabs
ELEVENLABS_API_KEY=sua_chave_aqui

# Google Gemini (Vertex / AI Studio)
GEMINI_API_KEY=sua_chave_aqui
GOOGLE_CLOUD_PROJECT=seu_projeto_google_cloud
GOOGLE_CLOUD_LOCATION=us-central1

# Tavily Web Search (Obrigatorio para Tools)
TAVILY_API_KEY=sua_chave_aqui

# GitHub MCP (repos, issues, PRs) — Personal Access Token com escopo repo
GITHUB_TOKEN=ghp_sua_chave_aqui

# MCP Gateway (ferramentas externas Tavily/GitHub/Filesystem)
MCP_GATEWAY_URL=http://127.0.0.1:8045

# Chat: texto não espera voz (TTS só no botão Ouvir / WhatsApp async)
TTS_ATIVO=1
TTS_CALL_TIMEOUT=25
CHAT_SYNTHESIS_TIMEOUT=45
WHATSAPP_LLM_TIMEOUT=90
WHATSAPP_TOOL_TIMEOUT=45
WHATSAPP_IMAGE_TIMEOUT=60
WPP_CHAT_TIMEOUT_MS=150000
WPP_PUSH_URL=http://127.0.0.1:8044/send

# Watchdog unificado (scripts/Watchdog-Lira.ps1 — Administrador / Install-Watchdog-Lira.ps1)
# Push remoto (Discord + Zap) — resumo periodico + alertas de queda
# Discord: usa LIRA_UPDATES_CHANNEL_ID + DISCORD_TOKEN (mesmo canal do changelog)
# WATCHDOG_DISCORD_WEBHOOK=https://discord.com/api/webhooks/ID/TOKEN  # opcional
# WATCHDOG_STATUS_PUSH=1
# WATCHDOG_STATUS_PUSH_SEC=3600
# WATCHDOG_HEALTH_PORT=8043
# WATCHDOG_POLL_SEC=120
# WATCHDOG_HTTP_TIMEOUT_SEC=10
# WATCHDOG_BACKOFF_SEC=300
# WATCHDOG_BACKOFF_DISCORD_SEC=300
# WATCHDOG_BACKOFF_DISCORD_ESCALATED_SEC=480
# WATCHDOG_BACKOFF_CONTROL_SEC=60
# WATCHDOG_RESTART_WA_API=1
# WATCHDOG_MONITOR_CONTROL_API=1
# WATCHDOG_HEARTBEAT_SEC=3600
# WATCHDOG_LOG_MAX_MB=5
# WATCHDOG_LOG_KEEP=5
# WATCHDOG_FAILURE_WINDOW_SEC=1800
# WATCHDOG_CIRCUIT_THRESHOLD=5
# WATCHDOG_BACKOFF_MAX_SEC=3600
# WATCHDOG_CIRCUIT_BACKOFF_SEC=1800

# --- Discord bot ---
# Sync global de slash no startup (consome rate limit; deixe vazio em dev)
# SYNC_GLOBAL_ON_START=0


# --- Control Center API (Sprint 4) ---
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=8042
# HUD Tauri (control_panel): aba Plataformas liga/desliga Discord e WhatsApp via /api/services
# Control API sobe rapido sem baixar SentenceTransformer (pode levar minutos na 1a vez)
CONTROL_API_LIGHT_START=1
# CONTROL_API_RAG_CHROMA=1  # ativa Chroma apos o servidor ja estar online

# --- WhatsApp (API dedicada — Sprint 3) ---
WHATSAPP_API_URL=http://127.0.0.1:8043
WHATSAPP_API_PORT=8043
WHATSAPP_API_HOST=127.0.0.1
# qr (padrão, HUD) ou pairing (código de 8 dígitos)
WPP_LINK_MODE=qr
WPP_PHONE=5511999999999
WPP_PUSH_PORT=8044
# WPP_RESET_SESSION=1  # apaga auth na próxima subida do bridge
WPP_OWNER_JID=5511999999999@s.whatsapp.net
WPP_OWNER_LID=seu_lid@lid

# --- Dono (MCP filesystem/github/memory/puppeteer + permissões) ---
# Discord: ID numérico do seu usuário (clique direito → Copiar ID)
DISCORD_OWNER_ID=seu_id_discord_aqui

# --- Azure TTS (Opcional - Legado) ---
AZURE_SPEECH_KEY=sua_chave_aqui
AZURE_REGION=brazilsouth

# --- TTS ---
# Google/Edge/Azure/OpenAI/ElevenLabs usam TTS_PROVIDER e TTS_SETTINGS no config.json.
# O OpenAI TTS usa OPENAI_API_KEY, voz multi-lingue e pitch por estilo.
# O ElevenLabs usa ELEVENLABS_API_KEY e aceita voice_id/model_id manualmente na GUI.
